<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Claxe design tokens.

        Theme colours below are only defaults: ThemeService replaces every key in the
        "theme" group from Assets/Themes/{id}.json at startup, and controls consume them
        with DynamicResource so a theme can be swapped at runtime.
    -->

    <!-- ===== Theme colours (overridden by ThemeService) ===== -->
    <Color x:Key="AccentColor">#B583FF</Color>
    <Color x:Key="AccentSecondaryColor">#DD7FD0</Color>
    <!-- Accent at low alpha: inner glow of the active tab / fading part of its outline. -->
    <Color x:Key="AccentWashColor">#30B583FF</Color>
    <Color x:Key="AccentFadeColor">#50B583FF</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0910" />
    <SolidColorBrush x:Key="ChromeTintBrush" Color="#100C17" Opacity="0.8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1626" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#261E33" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#30263F" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2A2236" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EEE9F7" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A59CBD" />
    <SolidColorBrush x:Key="AccentBrush" Color="#B583FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#B583FF" Opacity="0.16" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#DD7FD0" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#B583FF" Opacity="0.45" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F2B24C" />

    <!-- ===== Glass layers (theme independent, laid over the tinted backdrop) ===== -->
    <SolidColorBrush x:Key="GlassBrush" Color="#FFFFFF" Opacity="0.055" />
    <SolidColorBrush x:Key="GlassHoverBrush" Color="#FFFFFF" Opacity="0.035" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#FFFFFF" Opacity="0.08" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFFFFF" Opacity="0.08" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FFFFFF" Opacity="0.13" />
    <SolidColorBrush x:Key="InsetBrush" Color="#000000" Opacity="0.28" />
    <SolidColorBrush x:Key="InsetHoverBrush" Color="#000000" Opacity="0.36" />

    <!-- ===== Shape & density (overridden by ThemeService from CornerStyle / Density) ===== -->
    <sys:Double x:Key="TabCornerRadiusValue">10</sys:Double>
    <CornerRadius x:Key="TabCornerRadius">10,10,0,0</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">9</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">18</CornerRadius>
    <sys:Double x:Key="TitleBarHeight">44</sys:Double>
    <sys:Double x:Key="ToolbarHeight">48</sys:Double>
    <!-- Same values for Grid rows, which take GridLength. -->
    <GridLength x:Key="TitleBarRowHeight">44</GridLength>
    <GridLength x:Key="ToolbarRowHeight">48</GridLength>
    <sys:Double x:Key="TabHeight">36</sys:Double>
    <sys:Double x:Key="PillHeight">36</sys:Double>
    <sys:Double x:Key="IconButtonSize">36</sys:Double>

    <!-- ===== Typography ===== -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="BodyFontSize">13</sys:Double>
    <sys:Double x:Key="TabFontSize">12.5</sys:Double>
    <sys:Double x:Key="AddressFontSize">13.5</sys:Double>

</ResourceDictionary>
