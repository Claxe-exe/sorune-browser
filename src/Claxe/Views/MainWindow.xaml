<Window x:Class="Claxe.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Claxe.ViewModels"
        xmlns:controls="clr-namespace:Claxe.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Border x:Name="RootBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow" Height="40" />
                <RowDefinition x:Name="ToolbarRow" Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Title bar: tabs + caption buttons ============ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel Margin="8,0,0,0" LastChildFill="False">
                    <ItemsControl x:Name="TabStrip"
                                  DockPanel.Dock="Left"
                                  VerticalAlignment="Bottom"
                                  ItemsSource="{Binding Tabs}"
                                  Background="Transparent"
                                  Focusable="False"
                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                  MouseMove="TabStrip_MouseMove"
                                  MouseLeftButtonUp="TabStrip_MouseLeftButtonUp"
                                  LostMouseCapture="TabStrip_LostMouseCapture">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:TabStripPanel ReservedWidth="120" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TabViewModel}">
                                <Border x:Name="TabRoot"
                                        Height="34"
                                        Margin="0,0,2,0"
                                        Padding="10,0,5,0"
                                        CornerRadius="10,10,0,0"
                                        Background="Transparent"
                                        ToolTip="{Binding Title}"
                                        PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                        MouseUp="Tab_MouseUp">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                                            <Image x:Name="FaviconImage"
                                                   Source="{Binding Favicon}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock x:Name="DefaultIcon"
                                                       Text="&#xE774;"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="Collapsed" />
                                            <Path x:Name="Spinner"
                                                  Data="M 8,1.5 A 6.5,6.5 0 1 1 1.5,8"
                                                  Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  Visibility="Collapsed">
                                                <Path.RenderTransform>
                                                    <RotateTransform />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>

                                        <TextBlock x:Name="TitleText"
                                                   Grid.Column="1"
                                                   Margin="8,0,4,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12.5"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                                        <Button Grid.Column="2"
                                                Style="{StaticResource TabCloseButtonStyle}"
                                                VerticalAlignment="Center"
                                                Content="&#xE711;"
                                                ToolTip="Sekmeyi kapat (Ctrl+W)"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                        <Setter TargetName="DefaultIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="FaviconImage" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="DefaultIcon" Property="Visibility" Value="Collapsed" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinStoryboard">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Spinner"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.8"
                                                                     RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>

                                    <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource TabHoverBrush}" />
                                    </Trigger>

                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource ToolbarBrush}" />
                                        <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button DockPanel.Dock="Left"
                            Margin="4,4,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource IconButtonStyle}"
                            Content="&#xE710;"
                            ToolTip="Yeni sekme (Ctrl+T)"
                            Command="{Binding NewTabCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </DockPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;"
                            ToolTip="Simge durumuna küçült" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;"
                            Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseCaptionButtonStyle}" Content="&#xE8BB;"
                            ToolTip="Kapat" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- ============ Toolbar: navigation + address bar ============ -->
            <Border Grid.Row="1"
                    Background="{DynamicResource ToolbarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Content="&#xE72B;"
                            ToolTip="Geri (Alt+Sol ok)" Command="{Binding BackCommand}" />
                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE72A;"
                            ToolTip="İleri (Alt+Sağ ok)" Command="{Binding ForwardCommand}" Margin="2,0" />
                    <Button Grid.Column="2" Command="{Binding ReloadOrStopCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                <Setter Property="Content" Value="&#xE72C;" />
                                <Setter Property="ToolTip" Value="Yenile (F5)" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab.IsLoading}" Value="True">
                                        <Setter Property="Content" Value="&#xE711;" />
                                        <Setter Property="ToolTip" Value="Yüklemeyi durdur" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Address pill -->
                    <Border x:Name="AddressPill"
                            Grid.Column="3"
                            Height="34"
                            Margin="8,0,0,0"
                            CornerRadius="17"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid Margin="12,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Connection state -->
                            <TextBlock Grid.Column="0"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE721;" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="ToolTip" Value="Ara veya adres yaz" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab.Security}" Value="Secure">
                                                <Setter Property="Text" Value="&#xE72E;" />
                                                <Setter Property="ToolTip" Value="Bağlantı güvenli (HTTPS)" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveTab.Security}" Value="NotSecure">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                <Setter Property="ToolTip" Value="Güvenli değil: bağlantı şifrelenmemiş (HTTP)" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveTab.Security}" Value="CertificateError">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                <Setter Property="ToolTip" Value="Güvenli değil: sertifika geçersiz" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveTab.Security}" Value="Local">
                                                <Setter Property="Text" Value="&#xE946;" />
                                                <Setter Property="ToolTip" Value="Yerel adres veya dosya" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="13.5"
                                       IsHitTestVisible="False"
                                       Text="Ara veya adres yaz"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=AddressBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBox x:Name="AddressBox"
                                     Grid.Column="1"
                                     Style="{StaticResource AddressTextBoxStyle}"
                                     Text="{Binding ActiveTab.AddressText, UpdateSourceTrigger=PropertyChanged}"
                                     GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                                     PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding NavigateCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding RevertAddressCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ============ Web content ============ -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding HostedTabs}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TabViewModel}">
                        <ContentPresenter Content="{Binding WebView}"
                                          Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
