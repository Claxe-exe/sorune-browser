<Window x:Class="Claxe.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Claxe.ViewModels"
        xmlns:controls="clr-namespace:Claxe.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource BodyFontSize}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Neon line under the toolbar. -->
        <LinearGradientBrush x:Key="NeonLineBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="Transparent" />
            <GradientStop Offset="0.18" Color="{DynamicResource AccentColor}" />
            <GradientStop Offset="0.62" Color="{DynamicResource AccentSecondaryColor}" />
            <GradientStop Offset="1" Color="Transparent" />
        </LinearGradientBrush>

        <!-- Sidebar button of a web panel or extension -->
        <DataTemplate x:Key="PanelButtonTemplate" DataType="{x:Type vm:PanelViewModel}">
                                    <Grid Margin="0,2">
                                        <!-- Active marker -->
                                        <Border x:Name="Marker" Width="3" Height="18" CornerRadius="1.5"
                                                HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"
                                                Visibility="Hidden">
                                            <Border.Effect>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="{DynamicResource AccentColor}" />
                                            </Border.Effect>
                                        </Border>
                                        <Button x:Name="PanelButton"
                                                Width="38" Height="38"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="{Binding Name}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.TogglePanelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid Width="22" Height="22">
                                                <Border x:Name="LetterChip" CornerRadius="7" Background="{DynamicResource AccentSoftBrush}">
                                                    <TextBlock Text="{Binding Letter}" FontFamily="{StaticResource UiFont}" FontSize="12"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Image x:Name="IconImage" Source="{Binding Icon}" Width="20" Height="20"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="{controls:T 'Paneli kapat ve belleği boşalt'}"
                                                              Command="{Binding UnloadPanelCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="{controls:T 'Kenar çubuğundan kaldır'}"
                                                              Command="{Binding RemovePanelCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                            <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Icon, Converter={x:Static controls:IsNullConverter.Instance}}" Value="False">
                                            <Setter TargetName="LetterChip" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="PanelButton" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLoaded}" Value="False">
                                            <Setter TargetName="PanelButton" Property="Opacity" Value="0.75" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder">
        <Grid x:Name="RootGrid" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow" Height="{DynamicResource TitleBarRowHeight}" />
                <RowDefinition x:Name="ToolbarRow" Height="{DynamicResource ToolbarRowHeight}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Layer 0: blurred wallpaper + theme tint ============ -->
            <Image Grid.RowSpan="3"
                   Source="{Binding Backdrop}"
                   Stretch="UniformToFill"
                   IsHitTestVisible="False" />
            <Rectangle Grid.RowSpan="3" Fill="{DynamicResource ChromeTintBrush}" IsHitTestVisible="False" />
            <!-- Tab strip fading toward the open site's colour (brush set in code) -->
            <Rectangle x:Name="TitleTintRect" Grid.Row="0" IsHitTestVisible="False" />

            <!-- ============ Layer 1: mascot (its body is hidden behind the toolbar) ============ -->
            <controls:MascotView x:Name="Mascot"
                                 Grid.Row="0" Grid.RowSpan="2"
                                 Width="84"
                                 Margin="0,0,138,0"
                                 HorizontalAlignment="Right"
                                 Mood="{Binding Mascot.Mood}"
                                 CustomImage="{Binding Mascot.CustomImage}"
                                 Peek="{Binding Mascot.Peek}" />

            <!-- Mascot speech bubble, to the left of the mascot (only while it is visible) -->
            <Grid Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,226,0"
                  IsHitTestVisible="False" Panel.ZIndex="5"
                  Visibility="{Binding Visibility, ElementName=Mascot}">
                <Border x:Name="MascotBubble" Padding="12,5" CornerRadius="12,12,3,12" MaxWidth="340"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        Visibility="{Binding Mascot.Bubble, Converter={x:Static controls:IsNullConverter.Instance}, ConverterParameter=collapse}">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="14" Opacity="0.55" Color="{DynamicResource AccentColor}" />
                    </Border.Effect>
                    <TextBlock Text="{Binding Mascot.Bubble}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>
            </Grid>

            <!-- ============ Layer 2: title bar (tabs + caption buttons) ============ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel Margin="10,0,0,0" LastChildFill="False">
                    <!-- Claxe mark (decorative, part of the draggable title area) -->
                    <Canvas DockPanel.Dock="Left"
                            Width="22" Height="22"
                            Margin="2,0,10,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <Canvas.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.8" Color="{DynamicResource AccentColor}" />
                        </Canvas.Effect>
                        <Path Width="18" Height="18" Canvas.Left="0" Canvas.Top="3" Stretch="Uniform"
                              Data="M 12,0 C 12.8,6.5 17.5,11.2 24,12 C 17.5,12.8 12.8,17.5 12,24 C 11.2,17.5 6.5,12.8 0,12 C 6.5,11.2 11.2,6.5 12,0 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="{DynamicResource AccentColor}" />
                                    <GradientStop Offset="1" Color="{DynamicResource AccentSecondaryColor}" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <Path Width="7" Height="7" Canvas.Left="15" Canvas.Top="0" Stretch="Uniform"
                              Fill="{DynamicResource AccentSecondaryBrush}"
                              Data="M 12,0 C 12.8,6.5 17.5,11.2 24,12 C 17.5,12.8 12.8,17.5 12,24 C 11.2,17.5 6.5,12.8 0,12 C 6.5,11.2 11.2,6.5 12,0 Z" />
                    </Canvas>

                    <ItemsControl x:Name="TabStrip"
                                  DockPanel.Dock="Left"
                                  VerticalAlignment="Bottom"
                                  ItemsSource="{Binding Tabs}"
                                  Background="Transparent"
                                  Focusable="False"
                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                  MouseMove="TabStrip_MouseMove"
                                  MouseLeftButtonUp="TabStrip_MouseLeftButtonUp"
                                  LostMouseCapture="TabStrip_LostMouseCapture"
                                  PreviewMouseWheel="TabStrip_PreviewMouseWheel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:TabStripPanel ReservedWidth="72" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <!-- The active tab draws on top so its "feet" overlap the neighbours. -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="controls:TabStripPanel.IsCompact" Value="{Binding IsPinned}" />
                                <Setter Property="controls:TabStripPanel.IsCollapsed" Value="{Binding IsCollapsedInGroup}" />
                                <Setter Property="controls:TabStripPanel.LeadingWidth">
                                    <Setter.Value>
                                        <MultiBinding Converter="{x:Static controls:GroupLabelWidthConverter.Instance}">
                                            <Binding Path="IsGroupStart" />
                                            <Binding Path="Group.Name" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Panel.ZIndex" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TabViewModel}">
                                <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Tab group label, in front of the group's first tab: click collapses, right click edits -->
                                <Border x:Name="GroupLabel"
                                        Margin="4,3,4,4" Height="22" VerticalAlignment="Center"
                                        CornerRadius="8" Cursor="Hand"
                                        Background="{Binding Group.Brush}"
                                        Visibility="Collapsed"
                                        ToolTip="{controls:T 'Grubu daralt / genişlet (sağ tık: düzenle)'}"
                                        MouseLeftButtonUp="GroupLabel_MouseLeftButtonUp"
                                        MouseRightButtonUp="GroupLabel_MouseRightButtonUp">
                                    <Border.Width>
                                        <MultiBinding Converter="{x:Static controls:GroupLabelWidthConverter.Instance}" ConverterParameter="label">
                                            <Binding Path="IsGroupStart" />
                                            <Binding Path="Group.Name" />
                                        </MultiBinding>
                                    </Border.Width>
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.45" Color="Black" />
                                    </Border.Effect>
                                    <TextBlock Text="{Binding Group.Name}" Margin="10,0" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#140F1D" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>

                                <Grid x:Name="TabRoot"
                                      Grid.Column="1"
                                      Height="{DynamicResource TabHeight}"
                                      Background="Transparent"
                                      ToolTip="{Binding Title}"
                                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      Loaded="Tab_Loaded"
                                      PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                      MouseUp="Tab_MouseUp">
                                    <Grid.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{controls:T 'Yeni sekme'}" InputGestureText="Ctrl+T" Command="{Binding NewTabCommand}" />
                                            <MenuItem Header="{controls:T 'Yeni gizli sekme'}" InputGestureText="Ctrl+Shift+N" Command="{Binding NewPrivateTabCommand}" />
                                            <Separator />
                                            <MenuItem Header="{controls:T 'Yeniden yükle'}" Command="{Binding ReloadTabCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{controls:T 'Çoğalt'}" Command="{Binding DuplicateTabCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{controls:T 'Sabitle / sabitlemeyi kaldır'}" Command="{Binding TogglePinCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{controls:T 'Sesi kapat / aç'}" Command="{Binding ToggleMuteCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{controls:T 'Ses düzeyi…'}" Click="TabVolume_Click" />
                                            <MenuItem Header="{controls:T 'Şimdi uyut'}" Command="{Binding SleepTabCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="{controls:T 'Sağda yan yana aç'}" Command="{Binding SplitRightCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{controls:T 'Solda yan yana aç'}" Command="{Binding SplitLeftCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{controls:T 'Bölünmüş ekranı kapat'}" Command="{Binding CloseSplitCommand}"
                                                      Visibility="{Binding IsSplit, Converter={StaticResource BoolToVisibility}}" />
                                            <Separator />
                                            <MenuItem Header="{controls:T 'Yeni gruba ekle'}" Command="{Binding AddTabToNewGroupCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{controls:T 'Gruba ekle'}" IsEnabled="{Binding HasGroups}"
                                                      SubmenuOpened="GroupSubmenu_Opened">
                                                <MenuItem Header="…" />
                                            </MenuItem>
                                            <MenuItem Header="{controls:T 'Gruptan çıkar'}" Command="{Binding RemoveTabFromGroupCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Visibility="{Binding PlacementTarget.DataContext.Group, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={x:Static controls:IsNullConverter.Instance}, ConverterParameter=collapse}" />
                                            <Separator />
                                            <MenuItem Header="{controls:T 'Diğer sekmeleri kapat'}" Command="{Binding CloseOtherTabsCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{controls:T 'Sağdaki sekmeleri kapat'}" Command="{Binding CloseTabsToRightCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{controls:T 'Kapat'}" InputGestureText="Ctrl+W" Command="{Binding CloseTabCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <!-- Inactive hover: a rounded glass chip inside the tab -->
                                    <Border x:Name="HoverChip"
                                            Margin="3,4,3,5"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Background="Transparent" />

                                    <!-- Active: silhouette flowing into the toolbar, neon outline fading downwards -->
                                    <Grid x:Name="ActiveShape" Margin="-8,0,-8,0" Visibility="Collapsed" IsHitTestVisible="False">
                                        <controls:TabShape Fill="{DynamicResource GlassBrush}"
                                                           CornerRadius="{DynamicResource TabCornerRadiusValue}"
                                                           FootRadius="8" />
                                        <controls:TabShape CornerRadius="{DynamicResource TabCornerRadiusValue}"
                                                           FootRadius="8"
                                                           StrokeThickness="1.3">
                                            <controls:TabShape.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="{DynamicResource AccentWashColor}" />
                                                    <GradientStop Offset="0.8" Color="Transparent" />
                                                </LinearGradientBrush>
                                            </controls:TabShape.Fill>
                                            <controls:TabShape.Stroke>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="{DynamicResource AccentColor}" />
                                                    <GradientStop Offset="0.5" Color="{DynamicResource AccentFadeColor}" />
                                                    <GradientStop Offset="1" Color="Transparent" />
                                                </LinearGradientBrush>
                                            </controls:TabShape.Stroke>
                                            <controls:TabShape.Effect>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.6"
                                                                  Color="{DynamicResource AccentColor}" />
                                            </controls:TabShape.Effect>
                                        </controls:TabShape>
                                    </Grid>

                                    <!-- Divider between inactive tabs, fading at both ends -->
                                    <Rectangle x:Name="Divider"
                                               Width="1"
                                               Margin="0,9,-0.5,10"
                                               HorizontalAlignment="Right">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0" Color="#00FFFFFF" />
                                                <GradientStop Offset="0.5" Color="#2EFFFFFF" />
                                                <GradientStop Offset="1" Color="#00FFFFFF" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>



                                    <Rectangle x:Name="GroupLine" Height="2" Margin="6,0,6,1" VerticalAlignment="Bottom"
                                               RadiusX="1" RadiusY="1" Fill="{Binding Group.Brush}" IsHitTestVisible="False"
                                               Visibility="{Binding Group, Converter={x:Static controls:IsNullConverter.Instance}, ConverterParameter=collapse}" />

                                    <Grid x:Name="TabContent" Margin="13,0,7,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Plays sound: click to mute / unmute -->
                                        <!-- Plays sound / own volume: click for the volume slider, right click mutes -->
                                        <Button x:Name="AudioButton"
                                                Grid.Column="2"
                                                Style="{StaticResource TabCloseButtonStyle}"
                                                FontSize="11"
                                                VerticalAlignment="Center"
                                                Content="&#xE767;"
                                                ToolTip="{controls:T 'Ses düzeyi (sağ tık: sessize al)'}"
                                                Visibility="Collapsed"
                                                Click="AudioButton_Click"
                                                MouseRightButtonUp="AudioButton_MouseRightButtonUp"
                                                ContextMenuOpening="AudioButton_ContextMenuOpening" />

                                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                                            <Image x:Name="FaviconImage"
                                                   Source="{Binding Favicon}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock x:Name="DefaultIcon"
                                                       Text="&#xE774;"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="Collapsed" />
                                            <Path x:Name="Spinner"
                                                  Data="M 8,1.5 A 6.5,6.5 0 1 1 1.5,8"
                                                  Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  Visibility="Collapsed">
                                                <Path.RenderTransform>
                                                    <RotateTransform />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>

                                        <DockPanel x:Name="TitlePanel" Grid.Column="1" Margin="9,0,4,1">
                                            <TextBlock x:Name="SplitBadge" DockPanel.Dock="Left" Margin="0,0,6,0" Text="&#xE8A0;"
                                                       FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"
                                                       ToolTip="{controls:T 'Bölünmüş ekranda'}" />
                                            <Border x:Name="PrivateBadge" DockPanel.Dock="Left" Margin="0,0,6,0" Padding="5,1"
                                                    CornerRadius="5" VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentSoftBrush}" Visibility="Collapsed">
                                                <TextBlock Text="{controls:T 'Gizli'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <TextBlock x:Name="TitleText"
                                                       VerticalAlignment="Center"
                                                       FontSize="{StaticResource TabFontSize}"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </DockPanel>

                                        <Button x:Name="CloseButton"
                                                Grid.Column="3"
                                                Style="{StaticResource TabCloseButtonStyle}"
                                                VerticalAlignment="Center"
                                                Content="&#xE711;"
                                                ToolTip="{controls:T 'Sekmeyi kapat (Ctrl+W)'}"
                                                Visibility="Hidden"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Grid>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsGroupStart}" Value="True">
                                        <Setter TargetName="GroupLabel" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCollapsedInGroup}" Value="True">
                                        <Setter TargetName="TabRoot" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                        <Setter TargetName="DefaultIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="FaviconImage" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="DefaultIcon" Property="Visibility" Value="Collapsed" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinStoryboard">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Spinner"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.8"
                                                                     RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>

                                    <!-- Sleeping background tab (wakes up when selected) -->
                                    <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                                        <Setter TargetName="TitleText" Property="Opacity" Value="0.5" />
                                        <Setter TargetName="FaviconImage" Property="Opacity" Value="0.5" />
                                        <Setter TargetName="TabRoot" Property="ToolTip" Value="{controls:T 'Uyutuldu: bellek ve işlemci tasarrufu için. Tıklayınca uyanır.'}" />
                                    </DataTrigger>

                                    <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HoverChip" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                        <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Divider" Property="Visibility" Value="Hidden" />
                                    </Trigger>

                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="HoverChip" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="ActiveShape" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter TargetName="TitleText" Property="FontWeight" Value="Medium" />
                                        <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Divider" Property="Visibility" Value="Hidden" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsPrivate}" Value="True">
                                        <Setter TargetName="PrivateBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                        <Setter TargetName="AudioButton" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasCustomVolume}" Value="True">
                                        <Setter TargetName="AudioButton" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="AudioButton" Property="Content" Value="&#xE993;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter TargetName="AudioButton" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="AudioButton" Property="Content" Value="&#xE74F;" />
                                        <Setter TargetName="AudioButton" Property="ToolTip" Value="{controls:T 'Sessiz (tıkla: ses düzeyi, sağ tık: sesi aç)'}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsInSplit}" Value="True">
                                        <Setter TargetName="SplitBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>

                                    <!-- Pinned: icon only (last, so it wins over hover/active) -->
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter TargetName="TitlePanel" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="AudioButton" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="TabContent" Property="Margin" Value="16,0,0,0" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button DockPanel.Dock="Left"
                            Margin="10,2,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource IconButtonStyle}"
                            Width="30" Height="30"
                            Content="&#xE710;"
                            ToolTip="{controls:T 'Yeni sekme (Ctrl+T)'}"
                            Command="{Binding NewTabCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </DockPanel>

                <!-- Keeps tabs from running under the mascot. -->
                <Border x:Name="MascotSlot" Grid.Column="1" Width="84" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;"
                            ToolTip="{controls:T 'Simge durumuna küçült'}" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;"
                            Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseCaptionButtonStyle}" Content="&#xE8BB;"
                            ToolTip="{controls:T 'Kapat'}" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- ============ Layer 3: toolbar (glass) ============ -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <!-- Opaque base + the same backdrop as the window, offset so the two line up seamlessly. -->
                <Rectangle Fill="{DynamicResource WindowBackgroundBrush}" IsHitTestVisible="False" />
                <Canvas IsHitTestVisible="False">
                    <Image Canvas.Top="{Binding ActualHeight, ElementName=TitleRowProbe, Converter={x:Static controls:NegateConverter.Instance}}"
                           Width="{Binding ActualWidth, ElementName=RootGrid}"
                           Height="{Binding ActualHeight, ElementName=RootGrid}"
                           Source="{Binding Backdrop}"
                           Stretch="UniformToFill" />
                </Canvas>
                <Rectangle Fill="{DynamicResource ChromeTintBrush}" IsHitTestVisible="False" />
                <Rectangle Fill="{DynamicResource GlassBrush}" IsHitTestVisible="False" />
                <!-- Fades toward the open site's top colour (brush and animation set in code) -->
                <Rectangle x:Name="SiteTintRect" IsHitTestVisible="False" />

                <!-- Neon edge; turns into a moving highlight while the page loads. -->
                <Rectangle Height="1" VerticalAlignment="Bottom" Opacity="0.55"
                           Fill="{StaticResource NeonLineBrush}" IsHitTestVisible="False" />
                <Rectangle x:Name="LoadingBar"
                           Height="2" Width="220"
                           VerticalAlignment="Bottom" HorizontalAlignment="Left"
                           Opacity="0" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="0.7" Color="{DynamicResource AccentColor}" />
                            <GradientStop Offset="1" Color="{DynamicResource AccentSecondaryColor}" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="LoadingBarOffset" />
                    </Rectangle.RenderTransform>
                </Rectangle>

                <Grid Margin="8,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                        <!-- Picture-in-picture: only while the page has a video that supports it -->
                        <Button Style="{StaticResource IconButtonStyle}" Margin="0,0,2,0"
                                ToolTip="{controls:T 'Videoyu resim içinde resim yap'}"
                                Command="{Binding TogglePictureInPictureCommand}"
                                Visibility="{Binding ActiveTab.HasPictureInPictureVideo, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                            <!-- A screen with a small video window in its corner -->
                            <Grid Width="18" Height="14">
                                <Border BorderThickness="1.4" CornerRadius="2.5"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Border Width="8" Height="6" Margin="0,0,2.5,2.5" CornerRadius="1.2"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}" />
                            </Grid>
                        </Button>
                        <!-- Screenshot -->
                        <Button Style="{StaticResource IconButtonStyle}" Margin="0,0,2,0" Content="&#xE722;"
                                ToolTip="{controls:T 'Ekran görüntüsü'}" Click="ScreenshotButton_Click" />
                        <!-- Reader mode: only on pages that look like an article -->
                        <Button Margin="0,0,2,0" Content="&#xE736;"
                                ToolTip="{controls:T 'Okuma modu'}"
                                Command="{Binding OpenReaderCommand}"
                                Visibility="{Binding ActiveTab.IsReadable, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                                Style="{StaticResource IconButtonStyle}" />
                        <!-- Split screen: opens one with a new tab, or closes the current one -->
                        <Button Margin="0,0,2,0" Click="SplitButton_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Setter Property="Content" Value="&#xE8A0;" />
                                    <Setter Property="ToolTip" Value="{controls:T 'Bölünmüş ekran'}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSplit}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="ToolTip" Value="{controls:T 'Bölünmüş ekranı kapat'}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- Update downloaded: one click saves everything, installs and restarts -->
                        <Button x:Name="UpdateButton"
                                Height="30" Margin="0,0,6,0" Padding="10,0"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTip="{controls:T 'Yeni sürüm hazır: kaydedip yeniden başlatır'}"
                                Command="{Binding ApplyUpdateCommand}"
                                Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVisibility}}">
                            <Button.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="14" Opacity="0.7"
                                                  Color="{DynamicResource AccentColor}" />
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{controls:T 'Güncelle'}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- Downloads: appears after the first download of the run, with a progress line -->
                        <Button x:Name="DownloadsButton"
                                Style="{StaticResource IconButtonStyle}"
                                Margin="0,0,2,0"
                                ToolTip="{controls:T 'İndirmeler (Ctrl+J)'}"
                                Command="{Binding OpenDownloadsCommand}"
                                Visibility="{Binding ShowDownloadsButton, Converter={StaticResource BoolToVisibility}}">
                            <Grid Width="22" Height="22">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Height="2" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1"
                                           Fill="{DynamicResource GlassBorderBrush}">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveDownloadCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Height="2" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1"
                                           Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding DownloadProgress, TargetNullValue=0, FallbackValue=0}" />
                                    </Rectangle.RenderTransform>
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveDownloadCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE713;"
                                ToolTip="{controls:T 'Ayarlar (Ctrl+,)'}" Command="{Binding OpenSettingsCommand}" />
                    </StackPanel>

                    <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Content="&#xE72B;"
                            ToolTip="{controls:T 'Geri (Alt+Sol ok)'}" Command="{Binding BackCommand}" />
                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE72A;"
                            ToolTip="{controls:T 'İleri (Alt+Sağ ok)'}" Command="{Binding ForwardCommand}" Margin="2,0" />
                    <Button Grid.Column="2" Command="{Binding ReloadOrStopCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                <Setter Property="Content" Value="&#xE72C;" />
                                <Setter Property="ToolTip" Value="{controls:T 'Yenile (F5)'}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab.IsLoading}" Value="True">
                                        <Setter Property="Content" Value="&#xE711;" />
                                        <Setter Property="ToolTip" Value="{controls:T 'Yüklemeyi durdur'}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Address pill -->
                    <Border x:Name="AddressPill"
                            Grid.Column="3"
                            Height="{DynamicResource PillHeight}"
                            Margin="10,0,0,0"
                            CornerRadius="{DynamicResource PillCornerRadius}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource InsetHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource InsetHoverBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="14" Opacity="0.45"
                                                                  Color="{DynamicResource AccentColor}" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid Margin="14,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <!-- Zoom level (only when not 100 %); click resets -->
                            <Button Height="24" Margin="6,0,0,0" Padding="8,0"
                                    Style="{StaticResource GhostButtonStyle}" FontSize="11.5"
                                    Content="{Binding ActiveTab.ZoomPercent}"
                                    ToolTip="{controls:T 'Yakınlaştırmayı sıfırla (Ctrl+0)'}"
                                    Click="ResetZoom_Click"
                                    Visibility="{Binding ActiveTab.ZoomPercent, Converter={x:Static controls:IsNullConverter.Instance}, ConverterParameter=collapse}" />

                            <!-- Bookmark star (only for real web pages) -->
                            <Button Width="28" Height="28"
                                    Margin="6,0,0,0"
                                    Command="{Binding ToggleBookmarkCommand}"
                                    Visibility="{Binding CanBookmark, Converter={StaticResource BoolToVisibility}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Setter Property="Content" Value="&#xE734;" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="ToolTip" Value="{controls:T 'Yer imlerine ekle (Ctrl+D)'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActiveTabBookmarked}" Value="True">
                                                <Setter Property="Content" Value="&#xE735;" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="ToolTip" Value="{controls:T 'Yer iminden kaldır (Ctrl+D)'}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            </StackPanel>

                            <!-- Connection state -->
                            <TextBlock Grid.Column="0"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE721;" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="ToolTip" Value="{controls:T 'Ara veya adres yaz'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab.Security}" Value="Secure">
                                                <Setter Property="Text" Value="&#xE72E;" />
                                                <Setter Property="ToolTip" Value="{controls:T 'Bağlantı güvenli (HTTPS)'}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveTab.Security}" Value="NotSecure">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                <Setter Property="ToolTip" Value="{controls:T 'Güvenli değil: bağlantı şifrelenmemiş (HTTP)'}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveTab.Security}" Value="CertificateError">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                <Setter Property="ToolTip" Value="{controls:T 'Güvenli değil: sertifika geçersiz'}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveTab.Security}" Value="Local">
                                                <Setter Property="Text" Value="&#xE946;" />
                                                <Setter Property="ToolTip" Value="{controls:T 'Yerel adres veya dosya'}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource AddressFontSize}"
                                       IsHitTestVisible="False"
                                       Text="{controls:T 'Ara veya adres yaz'}"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=AddressBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBox x:Name="AddressBox"
                                     Grid.Column="1"
                                     Style="{StaticResource AddressTextBoxStyle}"
                                     Text="{Binding ActiveTab.AddressText, UpdateSourceTrigger=PropertyChanged}"
                                     GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                                     PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding NavigateCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding RevertAddressCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Invisible element whose height follows the title row (0 in fullscreen); the toolbar backdrop offset binds to it. -->
            <Border x:Name="TitleRowProbe" Grid.Row="0" IsHitTestVisible="False" />

            <!-- ============ Layer 4: sidebar, web panel, web content ============ -->
            <!-- Column order is set in code (sidebar left or right). -->
            <Grid Grid.Row="2" x:Name="ContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar: one button per web panel -->
                <Border x:Name="SidebarHost" Grid.Column="0" Width="52"
                        Background="{DynamicResource GlassBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                    <!-- Follows the open site's colour (brush set in code) -->
                    <Rectangle x:Name="SidebarTintRect" IsHitTestVisible="False" />
                    <DockPanel Margin="0,8">
                        <Button DockPanel.Dock="Bottom"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE710;" FontSize="12"
                                ToolTip="{controls:T 'Panelleri düzenle'}"
                                Command="{Binding ManagePanelsCommand}" />
                        <!-- Built-in mini tools -->
                        <Grid DockPanel.Dock="Bottom" Margin="0,2,0,0">
                            <Border Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="{Binding ToolsPanel.IsOpen, Converter={StaticResource BoolToVisibility}}" />
                            <Button Width="38" Height="38"
                                    ToolTip="{controls:T 'Mini araçlar'}"
                                    Command="{Binding TogglePanelCommand}"
                                    CommandParameter="{Binding ToolsPanel}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ToolsPanel.IsOpen}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Border Width="24" Height="24" CornerRadius="7" BorderThickness="1"
                                        BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Button>
                        </Grid>
                        <!-- Built-in file converter -->
                        <Grid DockPanel.Dock="Bottom" Margin="0,2,0,6">
                            <Border Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="{Binding ConverterPanel.IsOpen, Converter={StaticResource BoolToVisibility}}">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="{DynamicResource AccentColor}" />
                                </Border.Effect>
                            </Border>
                            <Button Width="38" Height="38"
                                    ToolTip="{controls:T 'Dosya dönüştürücü'}"
                                    Command="{Binding TogglePanelCommand}"
                                    CommandParameter="{Binding ConverterPanel}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConverterPanel.IsOpen}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Border Width="24" Height="24" CornerRadius="7">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Offset="0" Color="{DynamicResource AccentColor}" />
                                            <GradientStop Offset="1" Color="{DynamicResource AccentSecondaryColor}" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Foreground="#120E18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Button>
                        </Grid>
                        <Rectangle DockPanel.Dock="Bottom" Height="1" Margin="12,6" Fill="{DynamicResource GlassBorderBrush}" />
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Panels}" Focusable="False" ItemTemplate="{StaticResource PanelButtonTemplate}" />
                            <!-- Extensions with a popup open in the panel like web panels -->
                            <ItemsControl ItemsSource="{Binding ExtensionPanels}" Focusable="False" ItemTemplate="{StaticResource PanelButtonTemplate}" />
                        </StackPanel>
                    </DockPanel>
                    </Grid>
                </Border>

                <!-- Open web panel: header + every loaded panel's page (hidden ones stay alive) -->
                <Border x:Name="PanelHost" Grid.Column="1" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="38" Background="{DynamicResource GlassBrush}">
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                       Text="{Binding ActivePanel.Name}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                                <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30" FontSize="12"
                                        Content="&#xE72C;" ToolTip="{controls:T 'Paneli yenile'}" Command="{Binding ReloadPanelCommand}" />
                                <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30" FontSize="12"
                                        Content="&#xE8A7;" ToolTip="{controls:T 'Sekmede aç'}" Command="{Binding PanelToTabCommand}" />
                                <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30" FontSize="10"
                                        Content="&#xE711;" ToolTip="{controls:T 'Paneli kapat'}" Command="{Binding ClosePanelCommand}" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding HostedPanels}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PanelViewModel}">
                                    <ContentPresenter Content="{Binding Tab.WebView}"
                                                      Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <GridSplitter x:Name="PanelSplitter" Grid.Column="2" Width="4"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              Background="Transparent" Visibility="Collapsed"
                              DragCompleted="PanelSplitter_DragCompleted" />

                <!-- Framed page: a thin glowing edge just outside the inset page (shown only when enabled) -->
                <Border x:Name="PageFrame" Grid.Column="3" Visibility="Collapsed" IsHitTestVisible="False"
                        CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource GlassBorderBrush}"
                        Background="{DynamicResource WindowBackgroundBrush}">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="18" Opacity="0.5" Color="{DynamicResource AccentColor}" />
                    </Border.Effect>
                </Border>

                <!-- Pages: [left pane][divider][right pane]; without a split the shown page spans all three. -->
                <ItemsControl x:Name="ContentHost" Grid.Column="3" ItemsSource="{Binding HostedTabs}" Focusable="False"
                              SizeChanged="ContentHost_SizeChanged">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding SplitLeftWidth}" />
                                    <ColumnDefinition Width="{Binding SplitDividerWidth}" />
                                    <ColumnDefinition Width="{Binding SplitRightWidth}" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Grid.Column" Value="{Binding ContentColumn}" />
                            <Setter Property="Grid.ColumnSpan" Value="{Binding ContentColumnSpan}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TabViewModel}">
                            <DockPanel Visibility="{Binding IsShown, Converter={StaticResource BoolToVisibility}}">
                                <!-- Split pane header: click to make this half active; swap; leave the split -->
                                <Border x:Name="PaneHeader" DockPanel.Dock="Top" Height="30" Visibility="Collapsed"
                                        Background="{DynamicResource GlassBrush}" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                        Cursor="Hand" MouseLeftButtonDown="PaneHeader_MouseLeftButtonDown">
                                    <DockPanel Margin="10,0,4,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="26" Height="26" FontSize="10"
                                                Content="&#xE711;" ToolTip="{controls:T 'Bölünmüş ekranı kapat (sekmeler açık kalır)'}"
                                                Command="{Binding DataContext.CloseSplitCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="26" Height="26" FontSize="11"
                                                Content="&#xE8AB;" ToolTip="{controls:T 'Bölmelerin yerini değiştir'}"
                                                Command="{Binding DataContext.SwapSplitCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Image Source="{Binding Favicon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                        <TextBlock x:Name="PaneTitle" Text="{Binding Title}" VerticalAlignment="Center" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </DockPanel>
                                </Border>
                                <ContentPresenter Content="{Binding WebView}" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsInSplit}" Value="True">
                                    <Setter TargetName="PaneHeader" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsInSplit}" Value="True" />
                                        <Condition Binding="{Binding IsActive}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="PaneHeader" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="PaneTitle" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Split divider: sits in the gap between the panes (no web page above it), drag to resize -->
                <Border x:Name="SplitDivider" Grid.Column="3" Width="6" HorizontalAlignment="Left"
                        Background="Transparent" Cursor="SizeWE"
                        Visibility="{Binding IsSplitVisible, Converter={StaticResource BoolToVisibility}}"
                        MouseLeftButtonDown="SplitDivider_MouseLeftButtonDown"
                        MouseMove="SplitDivider_MouseMove"
                        MouseLeftButtonUp="SplitDivider_MouseLeftButtonUp">
                    <Rectangle Width="2" RadiusX="1" RadiusY="1" Margin="0,40" Fill="{DynamicResource AccentBrush}" Opacity="0.55" />
                </Border>
            </Grid>

            <!-- ============ Address suggestions ============ -->
            <Popup x:Name="SuggestionPopup"
                   PlacementTarget="{Binding ElementName=AddressPill}"
                   Placement="Bottom" VerticalOffset="6"
                   Width="{Binding ActualWidth, ElementName=AddressPill}"
                   AllowsTransparency="True" StaysOpen="True"
                   IsOpen="{Binding HasSuggestions, Mode=OneWay}">
                <Border Padding="6" CornerRadius="14" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4" BlurRadius="20" Opacity="0.45" Color="Black" />
                    </Border.Effect>
                    <ItemsControl x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SuggestionViewModel}">
                                <Border x:Name="Row" Padding="10,7" CornerRadius="9" Background="Transparent" Cursor="Hand"
                                        PreviewMouseLeftButtonDown="Suggestion_PreviewMouseLeftButtonDown">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Width="24" Text="{Binding Glyph}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" MaxWidth="320" VerticalAlignment="Center"
                                                   Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>

            <!-- ============ Command palette (Ctrl+K) ============ -->
            <Popup x:Name="PalettePopup"
                   PlacementTarget="{Binding ElementName=ContentGrid}"
                   Placement="Relative"
                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                   Closed="PalettePopup_Closed">
                <Border Width="620" Margin="16" Padding="10" CornerRadius="18"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="6" BlurRadius="30" Opacity="0.55" Color="Black" />
                    </Border.Effect>
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="44" Padding="14,0" CornerRadius="12"
                                Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,12,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" IsHitTestVisible="False"
                                           Text="{controls:T 'Komut, sekme ya da sayfa ara…'}" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PaletteBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="PaletteBox" Grid.Column="1" Style="{StaticResource AddressTextBoxStyle}" FontSize="14"
                                         TextChanged="PaletteBox_TextChanged" PreviewKeyDown="PaletteBox_PreviewKeyDown" />
                                <Border Grid.Column="2" Padding="7,2" CornerRadius="6" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlHoverBrush}">
                                    <TextBlock Text="Esc" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ListBox x:Name="PaletteList" Margin="0,8,0,0" MaxHeight="420"
                                 ItemsSource="{Binding PaletteItems}" SelectedIndex="{Binding PaletteIndex}"
                                 Background="Transparent" BorderThickness="0" Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Row" Padding="10,8" CornerRadius="10" Background="Transparent" Cursor="Hand"
                                                        PreviewMouseLeftButtonUp="PaletteRow_MouseLeftButtonUp">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PaletteItem}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Width="28" Text="{Binding Glyph}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" MaxWidth="260" VerticalAlignment="Center"
                                                   Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Popup>

            <!-- ============ Find in page ============ -->
            <Popup x:Name="FindPopup"
                   PlacementTarget="{Binding ElementName=AddressPill}"
                   Placement="Bottom" VerticalOffset="10"
                   HorizontalOffset="{Binding ActualWidth, ElementName=AddressPill, Converter={x:Static controls:FindOffsetConverter.Instance}}"
                   AllowsTransparency="True" StaysOpen="True">
                <Border Width="380" Padding="10,8" Margin="0,0,12,12" CornerRadius="14"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4" BlurRadius="20" Opacity="0.45" Color="Black" />
                    </Border.Effect>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" FontSize="10"
                                Content="&#xE711;" ToolTip="{controls:T 'Kapat (Esc)'}" Click="FindClose_Click" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" FontSize="11"
                                Content="&#xE70D;" ToolTip="{controls:T 'Sonraki (Enter)'}" Click="FindNext_Click" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" FontSize="11"
                                Content="&#xE70E;" ToolTip="{controls:T 'Önceki (Shift+Enter)'}" Click="FindPrevious_Click" />
                        <TextBlock x:Name="FindCount" DockPanel.Dock="Right" Margin="8,0" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox x:Name="FindBox" Style="{StaticResource AddressTextBoxStyle}" FontSize="13"
                                 TextChanged="FindBox_TextChanged" PreviewKeyDown="FindBox_PreviewKeyDown" />
                    </DockPanel>
                </Border>
            </Popup>

            <!-- ============ Crash recovery offer (only after a crash with "continue previous session" off) ============ -->
            <Popup PlacementTarget="{Binding ElementName=AddressPill}" Placement="Bottom" VerticalOffset="10"
                   AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                <Popup.Style>
                    <Style TargetType="Popup">
                        <Setter Property="IsOpen" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RecoveryOffer}" Value="{x:Null}">
                                <Setter Property="IsOpen" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter Property="IsOpen" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Popup.Style>
                <Border Margin="12" Width="380" Padding="18" CornerRadius="16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4" BlurRadius="24" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="290">
                                <TextBlock Text="{controls:T 'Sorune beklenmedik şekilde kapandı'}" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap">
                                    <Run Text="{controls:T 'Önceki oturumdaki sekmeler:'}" />
                                    <Run Text="{Binding RecoveryTabCount, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="{controls:T 'Hayır, teşekkürler'}" Style="{StaticResource GhostButtonStyle}" Command="{Binding DismissRecoveryCommand}" />
                            <Button Content="{controls:T 'Sekmeleri geri yükle'}" Margin="8,0,0,0" Style="{StaticResource AccentButtonStyle}" Command="{Binding AcceptRecoveryCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- ============ Permission prompt (a Popup is its own window, so it shows over web content) ============ -->
            <Popup x:Name="PermissionPopup"
                   PlacementTarget="{Binding ElementName=AddressPill}"
                   Placement="Bottom"
                   VerticalOffset="10"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   PopupAnimation="Fade">
                <Popup.Style>
                    <Style TargetType="Popup">
                        <Setter Property="IsOpen" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PendingPermission}" Value="{x:Null}">
                                <Setter Property="IsOpen" Value="False" />
                            </DataTrigger>
                            <!-- Never float over other apps while Claxe is in the background. -->
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter Property="IsOpen" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Popup.Style>
                <Border Margin="12" Width="360" Padding="18" CornerRadius="16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                        DataContext="{Binding PendingPermission}">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4" BlurRadius="24" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Host}" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="270" />
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5">
                                    <Run Text="{controls:T 'Şu izni istiyor:'}" />
                                    <Run Text="{Binding What, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Margin="0,16,0,0" Content="{controls:T 'Bu site için kararımı hatırla'}"
                                  IsChecked="{Binding Remember}" Style="{StaticResource ClaxeCheckBoxStyle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="{controls:T 'Engelle'}" Style="{StaticResource GhostButtonStyle}" Command="{Binding DenyCommand}" />
                            <Button Content="{controls:T 'İzin ver'}" Margin="8,0,0,0" Style="{StaticResource AccentButtonStyle}" Command="{Binding AllowCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
