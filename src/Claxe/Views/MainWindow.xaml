<Window x:Class="Claxe.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Claxe.ViewModels"
        xmlns:controls="clr-namespace:Claxe.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource BodyFontSize}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Neon line under the toolbar. -->
        <LinearGradientBrush x:Key="NeonLineBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="Transparent" />
            <GradientStop Offset="0.18" Color="{DynamicResource AccentColor}" />
            <GradientStop Offset="0.62" Color="{DynamicResource AccentSecondaryColor}" />
            <GradientStop Offset="1" Color="Transparent" />
        </LinearGradientBrush>
    </Window.Resources>

    <Border x:Name="RootBorder">
        <Grid x:Name="RootGrid" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow" Height="{DynamicResource TitleBarRowHeight}" />
                <RowDefinition x:Name="ToolbarRow" Height="{DynamicResource ToolbarRowHeight}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Layer 0: blurred wallpaper + theme tint ============ -->
            <Image Grid.RowSpan="3"
                   Source="{Binding Backdrop}"
                   Stretch="UniformToFill"
                   IsHitTestVisible="False" />
            <Rectangle Grid.RowSpan="3" Fill="{DynamicResource ChromeTintBrush}" IsHitTestVisible="False" />

            <!-- ============ Layer 1: mascot (its body is hidden behind the toolbar) ============ -->
            <controls:MascotView x:Name="Mascot"
                                 Grid.Row="0" Grid.RowSpan="2"
                                 Width="84"
                                 Margin="0,0,138,0"
                                 HorizontalAlignment="Right"
                                 Mood="{Binding Mascot.Mood}" />

            <!-- ============ Layer 2: title bar (tabs + caption buttons) ============ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel Margin="10,0,0,0" LastChildFill="False">
                    <!-- Claxe mark (decorative, part of the draggable title area) -->
                    <Canvas DockPanel.Dock="Left"
                            Width="22" Height="22"
                            Margin="2,0,10,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <Canvas.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.8" Color="{DynamicResource AccentColor}" />
                        </Canvas.Effect>
                        <Path Width="18" Height="18" Canvas.Left="0" Canvas.Top="3" Stretch="Uniform"
                              Data="M 12,0 C 12.8,6.5 17.5,11.2 24,12 C 17.5,12.8 12.8,17.5 12,24 C 11.2,17.5 6.5,12.8 0,12 C 6.5,11.2 11.2,6.5 12,0 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="{DynamicResource AccentColor}" />
                                    <GradientStop Offset="1" Color="{DynamicResource AccentSecondaryColor}" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <Path Width="7" Height="7" Canvas.Left="15" Canvas.Top="0" Stretch="Uniform"
                              Fill="{DynamicResource AccentSecondaryBrush}"
                              Data="M 12,0 C 12.8,6.5 17.5,11.2 24,12 C 17.5,12.8 12.8,17.5 12,24 C 11.2,17.5 6.5,12.8 0,12 C 6.5,11.2 11.2,6.5 12,0 Z" />
                    </Canvas>

                    <ItemsControl x:Name="TabStrip"
                                  DockPanel.Dock="Left"
                                  VerticalAlignment="Bottom"
                                  ItemsSource="{Binding Tabs}"
                                  Background="Transparent"
                                  Focusable="False"
                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                  MouseMove="TabStrip_MouseMove"
                                  MouseLeftButtonUp="TabStrip_MouseLeftButtonUp"
                                  LostMouseCapture="TabStrip_LostMouseCapture"
                                  PreviewMouseWheel="TabStrip_PreviewMouseWheel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:TabStripPanel ReservedWidth="72" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <!-- The active tab draws on top so its "feet" overlap the neighbours. -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Panel.ZIndex" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TabViewModel}">
                                <Grid x:Name="TabRoot"
                                      Height="{DynamicResource TabHeight}"
                                      Background="Transparent"
                                      ToolTip="{Binding Title}"
                                      Loaded="Tab_Loaded"
                                      PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                      MouseUp="Tab_MouseUp">

                                    <!-- Inactive hover: a rounded glass chip inside the tab -->
                                    <Border x:Name="HoverChip"
                                            Margin="3,4,3,5"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Background="Transparent" />

                                    <!-- Active: silhouette flowing into the toolbar, neon outline fading downwards -->
                                    <Grid x:Name="ActiveShape" Margin="-8,0,-8,0" Visibility="Collapsed" IsHitTestVisible="False">
                                        <controls:TabShape Fill="{DynamicResource GlassBrush}"
                                                           CornerRadius="{DynamicResource TabCornerRadiusValue}"
                                                           FootRadius="8" />
                                        <controls:TabShape CornerRadius="{DynamicResource TabCornerRadiusValue}"
                                                           FootRadius="8"
                                                           StrokeThickness="1.3">
                                            <controls:TabShape.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="{DynamicResource AccentWashColor}" />
                                                    <GradientStop Offset="0.8" Color="Transparent" />
                                                </LinearGradientBrush>
                                            </controls:TabShape.Fill>
                                            <controls:TabShape.Stroke>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="{DynamicResource AccentColor}" />
                                                    <GradientStop Offset="0.5" Color="{DynamicResource AccentFadeColor}" />
                                                    <GradientStop Offset="1" Color="Transparent" />
                                                </LinearGradientBrush>
                                            </controls:TabShape.Stroke>
                                            <controls:TabShape.Effect>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.6"
                                                                  Color="{DynamicResource AccentColor}" />
                                            </controls:TabShape.Effect>
                                        </controls:TabShape>
                                    </Grid>

                                    <!-- Divider between inactive tabs, fading at both ends -->
                                    <Rectangle x:Name="Divider"
                                               Width="1"
                                               Margin="0,9,-0.5,10"
                                               HorizontalAlignment="Right">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0" Color="#00FFFFFF" />
                                                <GradientStop Offset="0.5" Color="#2EFFFFFF" />
                                                <GradientStop Offset="1" Color="#00FFFFFF" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <Grid Margin="13,0,7,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                                            <Image x:Name="FaviconImage"
                                                   Source="{Binding Favicon}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock x:Name="DefaultIcon"
                                                       Text="&#xE774;"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="Collapsed" />
                                            <Path x:Name="Spinner"
                                                  Data="M 8,1.5 A 6.5,6.5 0 1 1 1.5,8"
                                                  Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  Visibility="Collapsed">
                                                <Path.RenderTransform>
                                                    <RotateTransform />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>

                                        <TextBlock x:Name="TitleText"
                                                   Grid.Column="1"
                                                   Margin="9,0,4,1"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource TabFontSize}"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                                        <Button x:Name="CloseButton"
                                                Grid.Column="2"
                                                Style="{StaticResource TabCloseButtonStyle}"
                                                VerticalAlignment="Center"
                                                Content="&#xE711;"
                                                ToolTip="Sekmeyi kapat (Ctrl+W)"
                                                Visibility="Hidden"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                        <Setter TargetName="DefaultIcon" Property="Visibility" Value="Visible" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="FaviconImage" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="DefaultIcon" Property="Visibility" Value="Collapsed" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinStoryboard">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Spinner"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.8"
                                                                     RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>

                                    <!-- Sleeping background tab (wakes up when selected) -->
                                    <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                                        <Setter TargetName="TitleText" Property="Opacity" Value="0.5" />
                                        <Setter TargetName="FaviconImage" Property="Opacity" Value="0.5" />
                                        <Setter TargetName="TabRoot" Property="ToolTip" Value="Uyutuldu: bellek ve işlemci tasarrufu için. Tıklayınca uyanır." />
                                    </DataTrigger>

                                    <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HoverChip" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                        <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Divider" Property="Visibility" Value="Hidden" />
                                    </Trigger>

                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="HoverChip" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="ActiveShape" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter TargetName="TitleText" Property="FontWeight" Value="Medium" />
                                        <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Divider" Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button DockPanel.Dock="Left"
                            Margin="10,2,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource IconButtonStyle}"
                            Width="30" Height="30"
                            Content="&#xE710;"
                            ToolTip="Yeni sekme (Ctrl+T)"
                            Command="{Binding NewTabCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </DockPanel>

                <!-- Keeps tabs from running under the mascot. -->
                <Border x:Name="MascotSlot" Grid.Column="1" Width="84" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;"
                            ToolTip="Simge durumuna küçült" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;"
                            Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseCaptionButtonStyle}" Content="&#xE8BB;"
                            ToolTip="Kapat" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- ============ Layer 3: toolbar (glass) ============ -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <!-- Opaque base + the same backdrop as the window, offset so the two line up seamlessly. -->
                <Rectangle Fill="{DynamicResource WindowBackgroundBrush}" IsHitTestVisible="False" />
                <Canvas IsHitTestVisible="False">
                    <Image Canvas.Top="{Binding ActualHeight, ElementName=TitleRowProbe, Converter={x:Static controls:NegateConverter.Instance}}"
                           Width="{Binding ActualWidth, ElementName=RootGrid}"
                           Height="{Binding ActualHeight, ElementName=RootGrid}"
                           Source="{Binding Backdrop}"
                           Stretch="UniformToFill" />
                </Canvas>
                <Rectangle Fill="{DynamicResource ChromeTintBrush}" IsHitTestVisible="False" />
                <Rectangle Fill="{DynamicResource GlassBrush}" IsHitTestVisible="False" />

                <!-- Neon edge; turns into a moving highlight while the page loads. -->
                <Rectangle Height="1" VerticalAlignment="Bottom" Opacity="0.55"
                           Fill="{StaticResource NeonLineBrush}" IsHitTestVisible="False" />
                <Rectangle x:Name="LoadingBar"
                           Height="2" Width="220"
                           VerticalAlignment="Bottom" HorizontalAlignment="Left"
                           Opacity="0" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="0.7" Color="{DynamicResource AccentColor}" />
                            <GradientStop Offset="1" Color="{DynamicResource AccentSecondaryColor}" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="LoadingBarOffset" />
                    </Rectangle.RenderTransform>
                </Rectangle>

                <Grid Margin="8,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                        <!-- Downloads: appears after the first download of the run, with a progress line -->
                        <Button x:Name="DownloadsButton"
                                Style="{StaticResource IconButtonStyle}"
                                Margin="0,0,2,0"
                                ToolTip="İndirmeler (Ctrl+J)"
                                Command="{Binding OpenDownloadsCommand}"
                                Visibility="{Binding ShowDownloadsButton, Converter={StaticResource BoolToVisibility}}">
                            <Grid Width="22" Height="22">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Height="2" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1"
                                           Fill="{DynamicResource GlassBorderBrush}">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveDownloadCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Height="2" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1"
                                           Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding DownloadProgress, TargetNullValue=0, FallbackValue=0}" />
                                    </Rectangle.RenderTransform>
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveDownloadCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE713;"
                                ToolTip="Ayarlar (Ctrl+,)" Command="{Binding OpenSettingsCommand}" />
                    </StackPanel>

                    <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Content="&#xE72B;"
                            ToolTip="Geri (Alt+Sol ok)" Command="{Binding BackCommand}" />
                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE72A;"
                            ToolTip="İleri (Alt+Sağ ok)" Command="{Binding ForwardCommand}" Margin="2,0" />
                    <Button Grid.Column="2" Command="{Binding ReloadOrStopCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                <Setter Property="Content" Value="&#xE72C;" />
                                <Setter Property="ToolTip" Value="Yenile (F5)" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab.IsLoading}" Value="True">
                                        <Setter Property="Content" Value="&#xE711;" />
                                        <Setter Property="ToolTip" Value="Yüklemeyi durdur" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Address pill -->
                    <Border x:Name="AddressPill"
                            Grid.Column="3"
                            Height="{DynamicResource PillHeight}"
                            Margin="10,0,0,0"
                            CornerRadius="{DynamicResource PillCornerRadius}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource InsetHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource InsetHoverBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="14" Opacity="0.45"
                                                                  Color="{DynamicResource AccentColor}" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid Margin="14,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Bookmark star (only for real web pages) -->
                            <Button Grid.Column="2"
                                    Width="28" Height="28"
                                    Margin="6,0,0,0"
                                    Command="{Binding ToggleBookmarkCommand}"
                                    Visibility="{Binding CanBookmark, Converter={StaticResource BoolToVisibility}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Setter Property="Content" Value="&#xE734;" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="ToolTip" Value="Yer imlerine ekle (Ctrl+D)" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActiveTabBookmarked}" Value="True">
                                                <Setter Property="Content" Value="&#xE735;" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="ToolTip" Value="Yer iminden kaldır (Ctrl+D)" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Connection state -->
                            <TextBlock Grid.Column="0"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE721;" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="ToolTip" Value="Ara veya adres yaz" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab.Security}" Value="Secure">
                                                <Setter Property="Text" Value="&#xE72E;" />
                                                <Setter Property="ToolTip" Value="Bağlantı güvenli (HTTPS)" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveTab.Security}" Value="NotSecure">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                <Setter Property="ToolTip" Value="Güvenli değil: bağlantı şifrelenmemiş (HTTP)" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveTab.Security}" Value="CertificateError">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                <Setter Property="ToolTip" Value="Güvenli değil: sertifika geçersiz" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ActiveTab.Security}" Value="Local">
                                                <Setter Property="Text" Value="&#xE946;" />
                                                <Setter Property="ToolTip" Value="Yerel adres veya dosya" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource AddressFontSize}"
                                       IsHitTestVisible="False"
                                       Text="Ara veya adres yaz"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=AddressBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBox x:Name="AddressBox"
                                     Grid.Column="1"
                                     Style="{StaticResource AddressTextBoxStyle}"
                                     Text="{Binding ActiveTab.AddressText, UpdateSourceTrigger=PropertyChanged}"
                                     GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                                     PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding NavigateCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding RevertAddressCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Invisible element whose height follows the title row (0 in fullscreen); the toolbar backdrop offset binds to it. -->
            <Border x:Name="TitleRowProbe" Grid.Row="0" IsHitTestVisible="False" />

            <!-- ============ Layer 4: sidebar, web panel, web content ============ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="PanelColumn" Width="0" MaxWidth="900" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar: one button per web panel -->
                <Border x:Name="SidebarHost" Grid.Column="0" Width="52"
                        Background="{DynamicResource GlassBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="0,8">
                        <Button DockPanel.Dock="Bottom"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE710;" FontSize="12"
                                ToolTip="Panelleri düzenle"
                                Command="{Binding ManagePanelsCommand}" />
                        <ItemsControl ItemsSource="{Binding Panels}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PanelViewModel}">
                                    <Grid Margin="0,2">
                                        <!-- Active marker -->
                                        <Border x:Name="Marker" Width="3" Height="18" CornerRadius="1.5"
                                                HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"
                                                Visibility="Hidden">
                                            <Border.Effect>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="{DynamicResource AccentColor}" />
                                            </Border.Effect>
                                        </Border>
                                        <Button x:Name="PanelButton"
                                                Width="38" Height="38"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="{Binding Name}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.TogglePanelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid Width="22" Height="22">
                                                <Border x:Name="LetterChip" CornerRadius="7" Background="{DynamicResource AccentSoftBrush}">
                                                    <TextBlock Text="{Binding Letter}" FontFamily="{StaticResource UiFont}" FontSize="12"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Image x:Name="IconImage" Source="{Binding Icon}" Width="20" Height="20"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Paneli kapat ve belleği boşalt"
                                                              Command="{Binding UnloadPanelCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Kenar çubuğundan kaldır"
                                                              Command="{Binding RemovePanelCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                            <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Icon, Converter={x:Static controls:IsNullConverter.Instance}}" Value="False">
                                            <Setter TargetName="LetterChip" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="PanelButton" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLoaded}" Value="False">
                                            <Setter TargetName="PanelButton" Property="Opacity" Value="0.75" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Open web panel: header + every loaded panel's page (hidden ones stay alive) -->
                <Border Grid.Column="1" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="38" Background="{DynamicResource GlassBrush}">
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                       Text="{Binding ActivePanel.Name}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                                <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30" FontSize="12"
                                        Content="&#xE72C;" ToolTip="Paneli yenile" Command="{Binding ReloadPanelCommand}" />
                                <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30" FontSize="12"
                                        Content="&#xE8A7;" ToolTip="Sekmede aç" Command="{Binding PanelToTabCommand}" />
                                <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30" FontSize="10"
                                        Content="&#xE711;" ToolTip="Paneli kapat" Command="{Binding ClosePanelCommand}" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Panels}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PanelViewModel}">
                                    <ContentPresenter Content="{Binding Tab.WebView}"
                                                      Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <GridSplitter x:Name="PanelSplitter" Grid.Column="2" Width="4"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              Background="Transparent" Visibility="Collapsed"
                              DragCompleted="PanelSplitter_DragCompleted" />

                <ItemsControl Grid.Column="3" ItemsSource="{Binding HostedTabs}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TabViewModel}">
                            <ContentPresenter Content="{Binding WebView}"
                                              Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- ============ Permission prompt (a Popup is its own window, so it shows over web content) ============ -->
            <Popup x:Name="PermissionPopup"
                   PlacementTarget="{Binding ElementName=AddressPill}"
                   Placement="Bottom"
                   VerticalOffset="10"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   PopupAnimation="Fade">
                <Popup.Style>
                    <Style TargetType="Popup">
                        <Setter Property="IsOpen" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PendingPermission}" Value="{x:Null}">
                                <Setter Property="IsOpen" Value="False" />
                            </DataTrigger>
                            <!-- Never float over other apps while Claxe is in the background. -->
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter Property="IsOpen" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Popup.Style>
                <Border Margin="12" Width="360" Padding="18" CornerRadius="16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                        DataContext="{Binding PendingPermission}">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4" BlurRadius="24" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Host}" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="270" />
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5">
                                    <Run Text="Şu izni istiyor:" />
                                    <Run Text="{Binding What, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Margin="0,16,0,0" Content="Bu site için kararımı hatırla"
                                  IsChecked="{Binding Remember}" Style="{StaticResource ClaxeCheckBoxStyle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Engelle" Style="{StaticResource GhostButtonStyle}" Command="{Binding DenyCommand}" />
                            <Button Content="İzin ver" Margin="8,0,0,0" Style="{StaticResource AccentButtonStyle}" Command="{Binding AllowCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
